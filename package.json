{
  "name": "@iiimaddiniii/remote-objects",
  "version": "0.1.0-1",
  "description": "A library wich enables the usage of JS-Objects across an communication interface",
  "homepage": "https://github.com/IIIMADDINIII/remote-objects#readme",
  "bugs": {
    "url": "https://github.com/IIIMADDINIII/remote-objects/issues"
  },
  "license": "MIT",
  "author": "IIIMADDINIII <martin@elend.name>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IIIMADDINIII/remote-objects"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ObjectStore": {
      "import": "./dist/ObjectStore.js",
      "require": "./dist/ObjectStore.cjs"
    },
    "./RequestHandler": {
      "import": "./dist/RequestHandler.js",
      "require": "./dist/RequestHandler.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "rolldown-plugin-access-privates": "^0.1.4",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
